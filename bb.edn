{:paths ["src"]
 :deps {io.github.lambduhh/temper {:git/sha "92ff73c8d3710432f5373bf776775f8164667d1b"}
        ;; quickblog main, not the v0.4.7 tag: main is the only version that
        ;; documents the alternate-content-root setup and the pre/post-process
        ;; hooks. Checked 2026-11-24.
        io.github.borkdude/quickblog {:git/sha "c1d82ce37ae05347fbeae13d330455db275327d5"}}
 :tasks
 {;; ---- Site tasks -------------------------------------------------------
  dev      {:doc "Build, serve public/ at http://localhost:1888/nooks-and-parens/, rebuild on changes. Flags: --as-of DATE --port N"
            :requires ([nooks.dev])
            :task (apply nooks.dev/-main *command-line-args*)}
  build    {:doc "Build the site into public/. Flags: --as-of 2026-12-07 or 2026-12-01T05:00Z (UTC; a bare date means 12:00 UTC)"
            :requires ([nooks.build])
            :task (apply nooks.build/-main *command-line-args*)}
  check    {:doc "Build for every date in the check set and run the invariants in docs/plan.md § Checks"
            :requires ([nooks.check])
            :task (apply nooks.check/-main *command-line-args*)}
  test     {:doc "Unit tests: data shape, state logic at the date edges, i18n"
            :extra-paths ["test"]
            :requires ([clojure.test :as t]
                       [nooks.data-test] [nooks.state-test] [nooks.i18n-test] [nooks.check-test] [nooks.template-test] [nooks.workbench-test])
            :task (let [{:keys [fail error]} (t/run-tests 'nooks.data-test 'nooks.state-test 'nooks.i18n-test 'nooks.check-test 'nooks.template-test 'nooks.workbench-test)]
                    (System/exit (if (zero? (+ fail error)) 0 1)))}
  test:browser {:doc "The Workbench in headless Chrome: every starter recipe, errors, keys, the infinite-loop failsafe, offline preview. Needs Chrome ($CHROME to override)"
                :extra-paths ["test"]
                :requires ([nooks.workbench-browser])
                :task (nooks.workbench-browser/-main)}
  blog:new {:doc "New blog post, created as a Preview (reachable by URL, not listed). Usage: bb blog:new \"Title\""
            :requires ([nooks.blog])
            :task (apply nooks.blog/new-post! *command-line-args*)}

  diagrams {:doc "Render the template guides' Mermaid diagrams to assets/diagrams/*.svg via kroki.io (commit them)"
            :requires ([nooks.template])
            :task (nooks.template/render-diagrams!)}
  template:bump {:doc "Point data/template.edn at the template repo's latest main (then bb check and a PR)"
                 :requires ([nooks.template])
                 :task (nooks.template/bump!)}

  ;; ---- Docs checks for the docs/ OKF bundle (temper.okf.*) --------------
  validate {:doc "Validate docs/ frontmatter (temper.okf.validate)"
            :requires ([temper.okf.validate])
            :task (apply temper.okf.validate/-main *command-line-args*)}
  links    {:doc "Check docs/ links and anchors (temper.okf.links). Flags: --quiet"
            :requires ([temper.okf.links])
            :task (apply temper.okf.links/-main *command-line-args*)}
  maturity {:doc "Regenerate the review-maturity table in CLAUDE.md (temper.okf.maturity). Flags: --check"
            :requires ([temper.okf.maturity])
            :task (apply temper.okf.maturity/-main *command-line-args*)}
  new-doc  {:doc "Scaffold a doc with valid frontmatter (temper.okf.new-doc)"
            :requires ([temper.okf.new-doc])
            :task (apply temper.okf.new-doc/-main *command-line-args*)}
  review   {:doc "Raise docs marked Viewed in a PR to L2 (temper.okf.review). Args: <pr> [--dry-run] [--commit [--push]]"
            :requires ([temper.okf.review])
            :task (apply temper.okf.review/-main *command-line-args*)}}}
